# Levenon — environment
#
# Copy to .env.local for development. Vercel: set the same key in Project
# Settings → Environment Variables.

# Shop WhatsApp number, full international form. OPTIONAL — it overrides the
# default in lib/whatsapp.ts, which is the single place the number is defined
# and is what ships when this is unset.
#
# Digits only or +/spaces/dashes — all are normalised. Every WhatsApp entry
# point on the site (checkout, floating button, product enquiry, contact page,
# footer, order tracking) resolves through that one module, so changing the
# number here or there changes all of them at once.
#
# Public by necessity: the order is built into a wa.me deep link client-side,
# so it must be NEXT_PUBLIC_ to reach the browser at build time.
# Malformed → the checkout renders "Checkout unavailable" rather than a broken
# link, and the optional entry points render nothing.
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567

# --- Catalogue database (Idraak / levenon_db, MySQL) -------------------------
# Leave unset to run on the static catalogue in lib/server/catalogue-data.ts.
# Verify a connection before trusting it:  npm run db:check
LEVENON_DB_HOST=127.0.0.1
LEVENON_DB_PORT=3306
LEVENON_DB_USER=
LEVENON_DB_PASSWORD=
LEVENON_DB_NAME=levenon_db
# Keep the pool small — this MySQL is shared with the dashboard backend.
LEVENON_DB_POOL=5

# --- Storefront subset (REQUIRED to publish from the database) ---------------
# The products table holds thousands of rows across many suppliers. Publishing
# all of it under the Levenon name would be wrong, so the database source only
# activates when at least one of these is set. Run `npm run db:check` to list
# supplier ids and their product counts.
LEVENON_SUPPLIER_IDS=
LEVENON_CATEGORY_IDS=
LEVENON_SKU_ALLOWLIST=

# Origin for Spatie media files, e.g.
# https://idraak-dev.s3.ap-southeast-1.amazonaws.com/levenon/Products
# Unset → no images are emitted and the thread-motif placeholder is used.
LEVENON_MEDIA_BASE_URL=

# --- Preferred connection form ----------------------------------------------
# Single URL, takes precedence over the discrete LEVENON_DB_* vars above.
# Replace every placeholder: a literal user/host template is rejected as unset.
DATABASE_URL=mysql://user:password@host:3306/levenon_db

# --- Which column the customer pays from ------------------------------------
# One column, or a comma-separated fallback chain. Unnamed columns still act as
# last-resort fallbacks so a product never maps to a price of zero.
# Business decision: in sampled data recommended_price (3361.00) is LOWER than
# base_price (3399.00), so this choice changes what customers are charged.
# Values: sale_price | recommended_price | base_price
LEVENON_PRICE_COLUMN=sale_price,recommended_price,base_price
